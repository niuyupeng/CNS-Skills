  "feature_definitions": {
    "title_level_analyzed": "A non-empty title was obtained from an official proceedings page.",
    "abstract_level_analyzed": "A non-empty abstract was obtained from an official article/abstract page.",
    "full_text_level_analyzed": "An official PDF was downloaded, validated by PDF magic bytes, and yielded at least 800 English-word tokens via pdftotext.",
    "intro_contribution_list": "Regex-assisted detection in the extracted Introduction segment; explicit_list requires a contribution marker plus enumerated/bulleted formatting.",
    "related_work_position": "Position of a dedicated Related Work-like heading relative to detected method and experiment headings.",
    "baseline_language": "Presence of baseline/comparator language anywhere in extracted text; not proof of comparator quality.",
    "ablation_reported": "Presence of ablation terminology; not a judgment that the ablation is causally decisive.",
    "uncertainty_reporting": "Presence of variance/error-bar/confidence-interval/seed/statistical-significance language; not a completeness score.",
    "figure_caption_count": "Unique caption identifiers detected at line starts in pdftotext output; approximate and may include appendix displays.",
    "structural_analysis_char_window": "Complete extracted text when <=450,000 characters; otherwise the first 300,000 plus final 150,000 characters. PDF hash, page count, and full-text word count still use the complete file/text."
  },
  "known_measurement_limits": [
    "PDF column order, equations, and appendix placement can confuse heading/caption regexes.",
    "Presence/absence metrics are descriptive signals, not acceptance criteria or quality scores.",
    "The sample is equal by venue, not weighted by venue population size.",
    "A single 2025 cross-section cannot estimate temporal trends.",
    "Full-text extraction does not mean line-by-line human close reading of every equation or appendix.",
    "For extracted texts above 450,000 characters, structural regexes use an explicit head-plus-tail window to bound runtime while retaining main-paper and end-matter regions."
  ]
